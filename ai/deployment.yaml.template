# /cicd/ai/deployment.yaml.template
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mindlog-ai-deployment
  namespace: default
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mindlog-ai
  template:
    metadata:
      annotations:
        instrumentation.newrelic.com/inject-python: "true"
      labels:
        app: mindlog-ai
    spec:
      containers:
      - name: ai-api
        image: ${ACCOUNT_ID}.dkr.ecr.ap-northeast-2.amazonaws.com/mindlog-ai:latest
        imagePullPolicy: Always
        ports:
        - containerPort: 8000
        command: ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
        env:
        # --- [New Relic] ---------------------------
        - name: NEW_RELIC_LICENSE_KEY
          valueFrom:
            secretKeyRef:
              name: mindlog-ai-secret
              key: LICENSE_KEY
        - name: NEW_RELIC_APP_NAME
          value: "mindlog-ai-prod"

        # --- [Static & DB Settings] ----------------
        - name: DB_USER
          value: "dbadmin"
        - name: DB_NAME
          value: "testdb"
        - name: AWS_REGION
          value: "ap-northeast-2"
        - name: DB_HOST
          value: "${RDS_ENDPOINT}"

        # --- [Dynamic URLs] ------------------------
        - name: REDIS_URL
          value: "rediss://${REDIS_ENDPOINT}:6379/0"
        - name: DATABASE_URL
          value: "postgresql://$(DB_USER):$(DB_PASSWORD)@$(DB_HOST):5432/$(DB_NAME)?sslmode=require"

        # --- [AWS Bedrock] -------------------------
        - name: BEDROCK_MODEL_ID
          value: "apac.anthropic.claude-3-haiku-20240307-v1:0"
        - name: BEDROCK_SUMMARY_MODEL_ID
          value: "global.anthropic.claude-haiku-4-5-20251001-v1:0"
        - name: BEDROCK_GUARDRAIL_ID
          value: "mhcfgpsodiox"
        - name: BEDROCK_GUARDRAIL_VERSION
          value: "DRAFT"

        # --- [Secrets] -----------------------------
        - name: DB_PASSWORD
          valueFrom:
            secretKeyRef:
              name: mindlog-ai-secret
              key: DB_PASSWORD
        - name: AWS_ACCESS_KEY_ID
          valueFrom:
            secretKeyRef:
              name: mindlog-ai-secret
              key: AWS_ACCESS_KEY_ID
        - name: AWS_SECRET_ACCESS_KEY
          valueFrom:
            secretKeyRef:
              name: mindlog-ai-secret
              key: AWS_SECRET_ACCESS_KEY
        - name: SECRET_KEY
          valueFrom:
            secretKeyRef:
              name: mindlog-ai-secret
              key: SECRET_KEY
        - name: OPENAI_API_KEY
          valueFrom:
            secretKeyRef:
              name: mindlog-ai-secret
              key: OPENAI_API_KEY

        livenessProbe:
          httpGet:
            path: /health
            port: 8000
          initialDelaySeconds: 30
          periodSeconds: 20
        readinessProbe:
          httpGet:
            path: /health
            port: 8000
          initialDelaySeconds: 15
          periodSeconds: 10
        resources:
          requests:
            cpu: "100m"
            memory: "256Mi"
          limits:
            cpu: "1000m"
            memory: "1024Mi"
