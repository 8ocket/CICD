apiVersion: apps/v1
kind: Deployment
metadata:
  name: mindlog-be-deployment
spec:
  replicas: 2
  selector:
    matchLabels:
      app: mindlog-be
  template:
    metadata:
      labels:
        app: mindlog-be
    spec:
      containers:
      - name: backend
        image: 854439979580.dkr.ecr.ap-northeast-2.amazonaws.com/mindlog-be:latest
        ports:
        - containerPort: 8080
        env:
        - name: SPRING_PROFILES_ACTIVE
          value: "dev"
        - name: PROFILE
          value: "dev"
        
        # RDS 엔드포인트 치환용
        - name: DB_DEV_HOST
          value: "rds-prod-8ocket.c5g8ga08stkl.ap-northeast-2.rds.amazonaws.com"
        # DB 연결 설정 (시크릿 연동)
        - name: SPRING_DATASOURCE_URL
          value: "jdbc:postgresql://$(DB_DEV_HOST):5432/mindlog_db?sslmode=require"
        - name: SPRING_DATASOURCE_USERNAME
          valueFrom:
            secretKeyRef:
              name: mindlog-be-secret
              key: DB_USERNAME
        - name: SPRING_DATASOURCE_PASSWORD
          valueFrom:
            secretKeyRef:
              name: mindlog-be-secret
              key: DB_PASSWORD

        - name: SPRING_JPA_DATABASE_PLATFORM
          value: "org.hibernate.dialect.PostgreSQLDialect"
        - name: SPRING_DATA_REDIS_HOST
          value: "master.valkey-prod-8ocket.q6r4ah.apn2.cache.amazonaws.com"          
        - name: SPRING_DATA_REDIS_PORT
          value: "6379"
            #- name: SPRING_DATA_REDIS_PASSWORD
            # valueFrom:
            #secretKeyRef:
            # name: mindlog-be-secret
            # key: REDIS_PASSWORD
        
        - name: KT_JWT_SECRET
          valueFrom:
            secretKeyRef:
              name: mindlog-be-secret
              key: KT_JWT_SECRET
        - name: AWS_S3_BUCKET_NAME
          value: "test-project-test-photos"
        - name: AWS_REGION
          value: "ap-northeast-2"

        - name: DEFAULT_PROFILE_IMAGE
          value: "https://test-project-test-photos.s3.ap-northeast-2.amazonaws.com/profile/profile-default.png"
        - name: DEFAULT_PERSONA_IMAGE
          value: "https://test-project-test-photos.s3.ap-northeast-2.amazonaws.com/persona/toast.png"
        - name: TEST_PERSONA_IMAGE
          value: "https://test-project-test-photos.s3.ap-northeast-2.amazonaws.com/persona/toast.png"

        livenessProbe:
          httpGet:
            path: /actuator/health
            port: 8080
          initialDelaySeconds: 180
